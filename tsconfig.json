{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "TypeScript Library",
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [".", ".eve/**/*.d.ts"],
	"exclude": ["node_modules", ".output"]
}
